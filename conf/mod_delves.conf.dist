# Development adapter only. No ordinary player entry path, verified encounter catalog or
# rewards exist yet. Enablement is startup-only; leave off on the live realm.
Delves.Prototype.Enable = 0

# Zero values deliberately prevent registration. Definitions must not change for
# a revision. Map ID 890 needs realm reservation and production DBC registration.
Delves.Prototype.ContentRevision = 0
Delves.Prototype.ObjectiveEntry = 0
Delves.Prototype.ObjectiveCount = 0
Delves.Prototype.BossEntry = 0

# Administrator-only development controls, not ordinary player admission.
# First verify safe coordinates in the matching client/geometry package.
Delves.Prototype.TestCommands.Enable = 0
Delves.Prototype.TestCommands.EntryConfigured = 0
Delves.Prototype.TestCommands.EntryX = 0
Delves.Prototype.TestCommands.EntryY = 0
Delves.Prototype.TestCommands.EntryZ = 0
Delves.Prototype.TestCommands.EntryO = 0

# First healer-role prototype; requires dedicated, reviewed world templates.
# Entry must bind npc_evermore_delve_brann and be friendly to its owner.
# PotionEntry must be GENERIC and bind go_evermore_delve_potion.
Delves.Prototype.Brann.Enable = 0
Delves.Prototype.Brann.Entry = 0
Delves.Prototype.Brann.PotionEntry = 0
# A loaded HEAL spell supplies combat-log metadata, not spell-power scaling.
# 2061 is the stock Flash Heal metadata; no cast or mana cost is performed.
Delves.Prototype.Brann.HealSpell = 2061
# Development balance choice, not a measured retail value. Allowed range 1-30.
Delves.Prototype.Brann.HealPercent = 20

# First boss combat adaptation. Requires a dedicated persistent creature with
# boss_evermore_abenar binding. Retail spell IDs are not valid client spell ports.
# Supply reviewed harmful 3.3.5 spell IDs; zero prevents script registration.
Delves.Prototype.Encounter.Enable = 0
Delves.Prototype.Encounter.WebBolt = 0
Delves.Prototype.Encounter.Agony = 0
Delves.Prototype.Encounter.Shackles = 0
