--------------------------------------------------------------------------------
-- Delves Teleporter (server) — ALE (AzerothCore Lua Engine)
-- Handles DT:<id> messages from the DelvesTeleporter client addon (hidden channel).
-- Allows non-GM players to teleport to whitelisted delve locations only.
--
-- Install: copy to server lua_scripts/delves/ and .reload ale
-- API docs: https://www.azerothcore.org/eluna/  (ALE, not legacy Eluna)
--------------------------------------------------------------------------------

local COMMAND_PREFIX = "DT:"
local LEAVE_COMMAND = "LEAVE"
local TELEPORT_COOLDOWN_SEC = 30

-- Map IDs for delve instances (used when validating leave)
local DELVE_MAPS = {
    [805] = true,
    [900] = true, [901] = true, [902] = true, [903] = true, [904] = true,
    [905] = true, [906] = true, [907] = true, [908] = true, [909] = true,
    [910] = true, [911] = true,
}

-- Whitelist keyed by game_tele id (matches 3_delves_game_tele.sql + Old Ironforge)
local DELVES = {
    [4000] = { map = 900,  x = 2725.53,   y = 1947.95,   z = 290.991,  o = 1.34494, name = "Stonetalon Ruins" },
    [4001] = { map = 901,  x = 9648.03,   y = -208.49,   z = 21.4029,  o = 0.44198, name = "Demon Hunter Cove" },
    [4002] = { map = 902,  x = 1700.36,   y = 1779.38,   z = 144.575,  o = 4.32832, name = "Stonetalon Logging Camp" },
    [4003] = { map = 904,  x = 2503.14,   y = 2590.45,   z = 62.9878,  o = 6.17658, name = "Blackchar Cave" },
    [4004] = { map = 905,  x = -12965.6,  y = -1277.65,  z = 45.9907,  o = 4.00283, name = "Sandfury Delve" },
    [4005] = { map = 906,  x = -1913.87,  y = -3907.36,  z = 110.664,  o = 4.72928, name = "Arathi Highlands Farm" },
    [4006] = { map = 907,  x = -8325.29,  y = -340.285,  z = 145.863,  o = 6.02208, name = "Elwynn Falls" },
    [4007] = { map = 908,  x = 4239.34,   y = -2683.87,  z = 5.78101,  o = 4.80625, name = "Quel'Thalas Island" },
    [4008] = { map = 909,  x = -5931.08,  y = 986.903,   z = 488.973,  o = 4.87313, name = "Forgotten Gnome Camp" },
    [4009] = { map = 910,  x = -6377.27,  y = -847.213,  z = 396.18,   o = 6.04825, name = "Newman's Landing" },
    [4010] = { map = 911,  x = -11627.4,  y = -2348.38,  z = 10.0889,  o = 3.81385, name = "Altar of Storms" },
    [4011] = { map = 0,    x = -4775.9087,y = -966.2051, z = 399.0429, o = 0,       name = "Old Ironforge" },
    [5013] = { map = 805,  x = 12822.0,   y = 15262.3,   z = 18.5815,  o = 0.0,     name = "Mustafar" },
}

local cooldownUntil = {}
local savedReturn = {}

local function IsDelveMap(mapId)
    return DELVE_MAPS[mapId] == true
end

local function SaveReturnPoint(player)
    local guid = player:GetGUIDLow()
    savedReturn[guid] = {
        map = player:GetMapId(),
        x = player:GetX(),
        y = player:GetY(),
        z = player:GetZ(),
        o = player:GetO(),
    }
end

local function CanTeleport(player)
    if player:IsDead() then
        return false, "You cannot teleport while dead."
    end
    if player:IsInCombat() then
        return false, "You cannot teleport while in combat."
    end
    -- ALE exposes IsFlying(), not IsInFlight() (legacy Eluna name)
    if player:IsFlying() then
        return false, "You cannot teleport while flying."
    end
    if player:InBattleground() or player:InArena() then
        return false, "You cannot teleport from a battleground or arena."
    end
    return true, nil
end

local function TryLeaveDelve(player)
    local guid = player:GetGUIDLow()
    local ret = savedReturn[guid]
    if not ret then
        player:SendBroadcastMessage("|cffFF0000[Delves]|r You are not in a delve (no return location saved).")
        return false
    end

    local ok, reason = CanTeleport(player)
    if not ok then
        player:SendBroadcastMessage("|cffFF0000[Delves]|r " .. reason)
        return false
    end

    player:Teleport(ret.map, ret.x, ret.y, ret.z, ret.o)
    savedReturn[guid] = nil
    cooldownUntil[guid] = os.time() + TELEPORT_COOLDOWN_SEC
    player:SendBroadcastMessage("|cff00FF00[Delves]|r Returned to your previous location.")
    return false
end

local function OnDelveTeleporterChat(event, player, msg, type, lang, channel)
    if not msg then
        return
    end

    if msg == COMMAND_PREFIX .. LEAVE_COMMAND then
        return TryLeaveDelve(player)
    end

    local teleId = tonumber(msg:match("^" .. COMMAND_PREFIX .. "(%d+)$"))
    if not teleId then
        return
    end

    local delve = DELVES[teleId]
    if not delve then
        player:SendBroadcastMessage("|cffFF0000[Delves]|r Unknown delve.")
        return false
    end

    local ok, reason = CanTeleport(player)
    if not ok then
        player:SendBroadcastMessage("|cffFF0000[Delves]|r " .. reason)
        return false
    end

    local guid = player:GetGUIDLow()
    local now = os.time()
    if cooldownUntil[guid] and cooldownUntil[guid] > now then
        local wait = cooldownUntil[guid] - now
        player:SendBroadcastMessage("|cffFF0000[Delves]|r Please wait " .. wait .. "s before teleporting again.")
        return false
    end

    if not IsDelveMap(player:GetMapId()) then
        SaveReturnPoint(player)
    end

    player:Teleport(delve.map, delve.x, delve.y, delve.z, delve.o)
    cooldownUntil[guid] = now + TELEPORT_COOLDOWN_SEC
    player:SendBroadcastMessage("|cff00FF00[Delves]|r Welcome to " .. delve.name .. ".")
    return false
end

-- Event 18 = SAY/YELL (fallback). Event 22 = custom channel (DelvesTP addon traffic).
RegisterPlayerEvent(18, OnDelveTeleporterChat)
RegisterPlayerEvent(22, OnDelveTeleporterChat)

local delveCount = 0
for _ in pairs(DELVES) do
    delveCount = delveCount + 1
end
print("[DelvesTeleporter] Loaded — " .. delveCount .. " delve destinations.")
